{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "naru": {
      "type": "streamable-http",
      "url": "https://naru.pub/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "read"
            ],
            "defaultScopes": [
              "read",
              "write"
            ]
          }
        }
      }
    }
  }
}
